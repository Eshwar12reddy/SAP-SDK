OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_CONTEXT_WINDOW=131072
OPENROUTER_CONTEXT_SAFETY_MARGIN=256
OPENROUTER_MIN_COMPLETION_TOKENS=16
OPENROUTER_GREETING_MAX_TOKENS=100
OPENROUTER_SIMPLE_MAX_TOKENS=300
OPENROUTER_DEFINITION_MAX_TOKENS=600
OPENROUTER_TECHNICAL_MAX_TOKENS=1500
OPENROUTER_COMPARISON_MAX_TOKENS=2000
OPENROUTER_HOW_TO_MAX_TOKENS=2500
OPENROUTER_TROUBLESHOOTING_MAX_TOKENS=3500
OPENROUTER_SCENARIO_MAX_TOKENS=5000
OPENROUTER_COMPLEX_MAX_TOKENS=8000
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=your_database_name
DATABASE_URL=postgresql://localhost:5432/your_database_name
# Required, at least 32 random characters (openssl rand -hex 32). The app refuses to start otherwise.
JWT_SECRET=
# Local development only: let the app create tables. Staging/production use Alembic migrations.
AUTO_CREATE_SCHEMA=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
