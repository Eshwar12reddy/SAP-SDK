# Copy to .env.staging on the server (chmod 600). NEVER commit .env.staging.
# Use URL-safe values (hex) for the database password: openssl rand -hex 24

# Public DNS name pointing at this server (A/AAAA record). Caddy issues the HTTPS certificate for it.
SITE_ADDRESS=staging.example.com

POSTGRES_USER=sapsdk
POSTGRES_PASSWORD=
POSTGRES_DB=sapsdk

# Required, >= 32 chars: openssl rand -hex 32
JWT_SECRET=

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional
AUTH_RATE_LIMIT=10/minute
# HTTP_PORT=80
# HTTPS_PORT=443
